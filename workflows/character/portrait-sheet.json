{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{CHECKPOINT}}"
    },
    "_meta": {"title": "Load Checkpoint (Character Portrait)"}
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {"title": "Square Portrait Latent (1024x1024)"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{TOPIC}}",
      "clip": ["4", 1]
    },
    "_meta": {"title": "Character Prompt"}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, low quality, worst quality, multiple people, crowd, cropped face, deformed anatomy, extra fingers, text, watermark, logo",
      "clip": ["4", 1]
    },
    "_meta": {"title": "Negative Prompt"}
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "_meta": {"title": "KSampler"}
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    },
    "_meta": {"title": "VAE Decode"}
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "Vertep_Character_Portrait",
      "images": ["8", 0]
    },
    "_meta": {"title": "Save Character Portrait"}
  }
}
