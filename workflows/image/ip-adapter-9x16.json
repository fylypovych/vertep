{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{CHECKPOINT}}"
    },
    "_meta": {"title": "Load Checkpoint"}
  },
  "10": {
    "class_type": "IPAdapterModelLoader",
    "inputs": {
      "ipadapter_file": "{{IPADAPTER_MODEL}}"
    },
    "_meta": {"title": "Load IP-Adapter Model"}
  },
  "11": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "{{CLIP_VISION_MODEL}}"
    },
    "_meta": {"title": "Load CLIP Vision"}
  },
  "12": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REFERENCE_IMAGE}}"
    },
    "_meta": {"title": "Load Character Reference"}
  },
  "13": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["4", 0],
      "ipadapter": ["10", 0],
      "image": ["12", 0],
      "clip_vision": ["11", 0],
      "weight": 0.8,
      "weight_type": "linear",
      "combine_embeds": "average",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    },
    "_meta": {"title": "Apply IP-Adapter"}
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 768,
      "height": 1344,
      "batch_size": 1
    },
    "_meta": {"title": "Empty Latent 9:16 (768x1344)"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{TOPIC}}",
      "clip": ["4", 1]
    },
    "_meta": {"title": "Positive Prompt"}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, low quality, worst quality, deformed face, extra limbs, text, watermark, logo",
      "clip": ["4", 1]
    },
    "_meta": {"title": "Negative Prompt"}
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 28,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1,
      "model": ["13", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "_meta": {"title": "KSampler"}
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    },
    "_meta": {"title": "VAE Decode"}
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "Vertep_IPAdapter_9x16",
      "images": ["8", 0]
    },
    "_meta": {"title": "Save Image"}
  }
}
