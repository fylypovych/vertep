#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH=$(readlink -f "$0")
ROOT=$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)
if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi
if [[ -f /etc/vertep/node.conf ]]; then
  set -a
  # shellcheck disable=SC1091
  source /etc/vertep/node.conf
  set +a
fi
role=${ROLE:-unknown}
core_url=${VERTEP_CORE_URL:-${CORE_ADDRESS:-http://localhost:8080}}
[[ "$core_url" == http://* || "$core_url" == https://* ]] || core_url="http://$core_url"
case "${1:-status}" in
  status)
    if [[ "$role" == "worker" ]]; then
      payload=$(curl -fsS --connect-timeout 3 -H "X-Vertep-Token: ${NODE_API_TOKEN:-}" "$core_url/api/node/status/${NODE_NAME:-unknown}" 2>/dev/null || printf '{}')
    else
      payload=$(curl -fsS --connect-timeout 3 -u "${ADMIN_USER:-admin}:${ADMIN_PASSWORD:-}" "$core_url/api/status" 2>/dev/null || printf '{}')
    fi
    printf '%s' "$payload" | python3 "$ROOT/scripts/status.py"
    ;;
  update)
    auth=()
    [[ -n "${ADMIN_PASSWORD:-}" ]] && auth=(-u "${ADMIN_USER:-admin}:${ADMIN_PASSWORD}")
    curl -fsS "${auth[@]}" -X POST "$core_url/api/system/update/run"
    printf '\nUpdate request accepted; follow progress with vertep status.\n'
    ;;
  apply-update)
    package=${2:-}
    target_version=${3:-}
    [[ -f "$package" && -n "$target_version" ]] || { echo "Signed update package and version are required" >&2; exit 2; }
    mkdir -p "$ROOT/backups"
    stamp=$(date +%Y%m%d-%H%M%S)
    backup="$ROOT/backups/update-$stamp"
    mkdir -p "$backup"
    printf '%s\n' "$target_version" > "$backup/target-version"
    tar --exclude=.git --exclude=backups --exclude=runtime --exclude='*.pyc' \
      -czf "$backup/application.tar.gz" -C "$ROOT" .
    for item in .env config /etc/vertep/node.conf; do
      [[ -e "$ROOT/$item" ]] && cp -a "$ROOT/$item" "$backup/" || true
      [[ "$item" == /* && -e "$item" ]] && cp -a "$item" "$backup/" || true
    done
    printf '%s\n' "$backup" > "$ROOT/.vertep-last-good"
    if [[ "$role" == "core" || "$role" == "core-worker" ]]; then
      backup_compose=(docker compose --env-file "$ROOT/.env" -f "$ROOT/docker-compose.yml")
      [[ "${GPU_VENDOR:-none}" == amd && -f "$ROOT/docker-compose.amd.yml" ]] \
        && backup_compose+=(-f "$ROOT/docker-compose.amd.yml")
      [[ "${GPU_VENDOR:-none}" == nvidia && -f "$ROOT/docker-compose.nvidia.yml" ]] \
        && backup_compose+=(-f "$ROOT/docker-compose.nvidia.yml")
      "${backup_compose[@]}" exec -T core tar -czf - /data/storage > "$backup/storage.tar.gz"
      "${backup_compose[@]}" exec -T core tar -czf - /data/config > "$backup/core-config.tar.gz"
      "${backup_compose[@]}" exec -T postgres pg_dump -U vertep vertep > "$backup/postgres.sql"
      "${backup_compose[@]}" exec -T postgres psql -U vertep -d vertep \
        -Atc 'SELECT version, applied_at FROM schema_migrations ORDER BY applied_at' > "$backup/migrations.log" 2>/dev/null || true
      "${backup_compose[@]}" exec -T redis redis-cli -a "${REDIS_PASSWORD:-}" SAVE >/dev/null
      "${backup_compose[@]}" cp redis:/data/dump.rdb "$backup/redis.rdb"
      printf '{"role":"%s","created_at":"%s","target_version":"%s"}\n' \
        "$role" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$target_version" > "$backup/inventory.json"
      touch "$backup/database-restore-required"
    fi
    (cd "$backup" && find . -type f ! -name SHA256SUMS -print0 \
      | sort -z | xargs -0 sha256sum > SHA256SUMS)
    staging=$(mktemp -d "$ROOT/.update-staging.XXXXXX")
    trap 'rm -rf "$staging"' EXIT
    python3 "$ROOT/scripts/safe-extract.py" "$package" "$staging"
    payload="$staging"
    [[ $(find "$staging" -mindepth 1 -maxdepth 1 -type d | wc -l) == 1 && ! -f "$staging/VERSION" ]] && payload=$(find "$staging" -mindepth 1 -maxdepth 1 -type d | head -1)
    [[ -f "$payload/VERSION" && "$(tr -d '[:space:]' < "$payload/VERSION")" == "$target_version" ]] || { echo "Package VERSION does not match manifest" >&2; exit 1; }
    # Migrate an older mutable installation into the release layout once.  The
    # backup archive is already verified during rollback and excludes releases.
    if [[ ! -L "$ROOT/current" ]]; then
      legacy_staging=$(mktemp -d "$ROOT/.legacy-release.XXXXXX")
      tar -xzf "$backup/application.tar.gz" -C "$legacy_staging"
      legacy_version=$(tr -d '[:space:]' < "$legacy_staging/VERSION")
      python3 "$ROOT/scripts/release-layout.py" prepare "$ROOT" "$legacy_staging::$legacy_version" >/dev/null
      python3 "$ROOT/scripts/release-layout.py" activate "$ROOT" "$legacy_version"
      rm -rf "$legacy_staging"
    fi
    python3 "$ROOT/scripts/release-layout.py" prepare "$ROOT" "$payload::$target_version" >/dev/null
    python3 "$ROOT/scripts/release-layout.py" activate "$ROOT" "$target_version"
    release_root="$ROOT/current"
    # Compose interpolation must use the persistent environment, while the
    # signed compose definition and application files come from the release.
    compose=(docker compose --env-file "$ROOT/.env" -f "$release_root/docker-compose.yml")
    [[ "${GPU_VENDOR:-none}" == amd && -f "$release_root/docker-compose.amd.yml" ]] \
      && compose+=(-f "$release_root/docker-compose.amd.yml")
    [[ "${GPU_VENDOR:-none}" == nvidia && -f "$release_root/docker-compose.nvidia.yml" ]] \
      && compose+=(-f "$release_root/docker-compose.nvidia.yml")
    if [[ "$role" == "core" || "$role" == "core-worker" ]]; then
      "${compose[@]}" up -d postgres redis
      database_ready=false
      for attempt in {1..30}; do
        if "${compose[@]}" exec -T postgres pg_isready -U vertep -d vertep >/dev/null 2>&1; then
          database_ready=true
          break
        fi
        sleep 2
      done
      [[ "$database_ready" == true ]] || { echo "PostgreSQL did not become ready; CORE was not restarted." >&2; exit 1; }
      "${compose[@]}" exec -T postgres psql -v ON_ERROR_STOP=1 -U vertep -d vertep \
        -c "CREATE TABLE IF NOT EXISTS schema_migrations(version TEXT PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT now())"
      for migration in "$release_root"/db/[0-9][0-9][0-9]_*.sql; do
        [[ -f "$migration" ]] || continue
        version=$(basename "$migration")
        applied=$("${compose[@]}" exec -T postgres \
          psql -U vertep -d vertep -tAc "SELECT 1 FROM schema_migrations WHERE version='$version'")
        [[ "$applied" == "1" ]] && continue
        "${compose[@]}" exec -T postgres \
          psql -v ON_ERROR_STOP=1 -U vertep -d vertep < "$migration"
        "${compose[@]}" exec -T postgres \
          psql -v ON_ERROR_STOP=1 -U vertep -d vertep -c "INSERT INTO schema_migrations(version) VALUES('$version')"
      done
    fi
    case "$role" in
      worker) "${compose[@]}" up -d worker ;;
      core) "${compose[@]}" up -d core redis postgres ;;
      core-worker) "${compose[@]}" up -d ;;
      *) echo "Unknown node role in /etc/vertep/node.conf" >&2; exit 1 ;;
    esac
    if [[ "$role" == "core" || "$role" == "core-worker" ]] && command -v systemctl >/dev/null 2>&1; then
      sed "s|@VERTEP_ROOT@|$ROOT|g" "$ROOT/installer/vertep-update.service" > /etc/systemd/system/vertep-update.service
      sed "s|@VERTEP_ROOT@|$ROOT|g" "$ROOT/installer/vertep-update.path" > /etc/systemd/system/vertep-update.path
      sed "s|@VERTEP_ROOT@|$ROOT|g" "$ROOT/installer/vertep-update-check.service" > /etc/systemd/system/vertep-update-check.service
      cp "$ROOT/installer/vertep-update.timer" /etc/systemd/system/vertep-update.timer
      systemctl daemon-reload
      systemctl enable --now vertep-update.path
      systemctl enable --now vertep-update.timer
    fi
    for attempt in {1..15}; do
      if [[ "$role" == "worker" ]]; then
        "${compose[@]}" ps --status running --services | grep -qx worker && exit 0
      elif curl -fsS -u "${ADMIN_USER:-admin}:${ADMIN_PASSWORD:-}" "$core_url/api/health"; then
        exit 0
      fi
      sleep 2
    done
    echo "Update health check failed; the update agent will rollback automatically." >&2
    exit 1
    ;;
  rollback)
    [[ -f "$ROOT/.vertep-last-good" ]] || { echo "No rollback revision recorded" >&2; exit 1; }
    backup=$(cat "$ROOT/.vertep-last-good")
    [[ -f "$backup/application.tar.gz" ]] || { echo "Last-good application backup is missing" >&2; exit 1; }
    [[ -f "$backup/SHA256SUMS" ]] || { echo "Last-good backup has no checksum manifest" >&2; exit 1; }
    (cd "$backup" && sha256sum -c SHA256SUMS)
    python3 "$ROOT/scripts/release-layout.py" rollback "$ROOT"
    release_root="$ROOT/current"
    compose=(docker compose --env-file "$ROOT/.env" -f "$release_root/docker-compose.yml")
    [[ "${GPU_VENDOR:-none}" == amd && -f "$release_root/docker-compose.amd.yml" ]] \
      && compose+=(-f "$release_root/docker-compose.amd.yml")
    [[ "${GPU_VENDOR:-none}" == nvidia && -f "$release_root/docker-compose.nvidia.yml" ]] \
      && compose+=(-f "$release_root/docker-compose.nvidia.yml")
    if [[ ( "$role" == "core" || "$role" == "core-worker" ) \
          && -f "$backup/database-restore-required" && -s "$backup/postgres.sql" ]]; then
      "${compose[@]}" stop core || true
      "${compose[@]}" up -d postgres
      database_ready=false
      for attempt in {1..30}; do
        if "${compose[@]}" exec -T postgres \
          pg_isready -U vertep -d vertep >/dev/null 2>&1; then
          database_ready=true
          break
        fi
        sleep 2
      done
      [[ "$database_ready" == true ]] || { echo "PostgreSQL did not become ready for rollback" >&2; exit 1; }
      "${compose[@]}" exec -T postgres \
        psql -v ON_ERROR_STOP=1 -U vertep -d vertep \
        -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'
      "${compose[@]}" exec -T postgres \
        psql -v ON_ERROR_STOP=1 -U vertep -d vertep < "$backup/postgres.sql"
      if [[ -s "$backup/storage.tar.gz" ]]; then
        "${compose[@]}" up -d core
        "${compose[@]}" exec -T core tar -xzf - -C / < "$backup/storage.tar.gz"
      fi
      if [[ -s "$backup/core-config.tar.gz" ]]; then
        "${compose[@]}" up -d core
        "${compose[@]}" exec -T core tar -xzf - -C / < "$backup/core-config.tar.gz"
      fi
      if [[ -s "$backup/redis.rdb" ]]; then
        "${compose[@]}" stop redis || true
        "${compose[@]}" cp "$backup/redis.rdb" redis:/data/dump.rdb
        "${compose[@]}" start redis
      fi
    fi
    case "$role" in
      worker) "${compose[@]}" up -d worker ;;
      core) "${compose[@]}" up -d core redis postgres ;;
      core-worker) "${compose[@]}" up -d ;;
      *) echo "Unknown node role in /etc/vertep/node.conf" >&2; exit 1 ;;
    esac
    ;;
  *) echo "Usage: vertep {status|update|rollback}"; exit 2 ;;
esac
