[Unit]
Description=Request a periodic Vertep update check
After=network-online.target vertep-update.path

[Service]
Type=oneshot
EnvironmentFile=-@VERTEP_ROOT@/.env
ExecStart=/usr/bin/curl --fail --silent --show-error --insecure -H "X-Vertep-Internal-Key: ${INTERNAL_API_KEY}" -X POST https://127.0.0.1:8443/api/system/update/check
PrivateTmp=true
NoNewPrivileges=true
