                "tests/test_lab_executor.py", "tests/test_lab_github_transport.py", "tests/test_lab_governance.py",
                "tests/test_lab_gpu_lease.py", "tests/test_lab_ir_acceptance.py", "tests/test_lab_isolation.py",
                "tests/test_lab_lease_api.py", "tests/test_lab_notifications.py", "tests/test_lab_orchestrator.py",
                "tests/test_lab_policy_gate.py", "tests/test_lab_qualification.py",
                "tests/test_lab_report_context.py", "tests/test_lab_reports.py",
                "tests/test_lab_resource_transport.py", "tests/test_lab_rights_requests.py",
                "tests/test_lab_role_profiles.py", "tests/test_lab_role_service_concurrency.py",
                "tests/test_lab_sandbox_isolation.py", "tests/test_lab_sandbox_runtime.py",
