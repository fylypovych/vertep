DEMO_MODE=true
CORE_ADDRESS=http://core:8080
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
BACKUP_URL=http://backup-service:8092
LICENSE_MANAGER_URL=http://license-manager:8093
DISPATCHER_URL=http://dispatcher:8094
SCHEDULER_URL=http://scheduler:8095
CERTIFICATE_MANAGER_URL=http://certificate-manager:8096
COMFYUI_URL=http://host.docker.internal:8188
COMFYUI_CHECKPOINT=model.safetensors
JOB_ROOT=/data/jobs
HEARTBEAT_TIMEOUT=45
POSTGRES_PASSWORD=replace-this-locally
POSTGRES_HOST=postgres
STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://vertep:replace-this-locally@postgres:5432/vertep
UPDATE_DATABASE_URL=postgresql://vertep:replace-this-locally@127.0.0.1:5432/vertep
SYSTEM_STATE_BACKEND=postgres
LOCAL_WORKER_FALLBACK=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_DEFAULT_CHARACTER=did_samogon
TELEGRAM_DEFAULT_PRIORITY=5
TELEGRAM_MAX_FILE_BYTES=26214400
PUBLIC_URL=
WEB_DOMAIN=
ADMIN_PASSWORD=replace-this-locally
ADMIN_USER=admin
NODE_API_TOKEN=replace-with-a-long-random-value
WORKER_TOKENS=
WORKER_TOKEN_HASHES=
REVOKED_TOKEN_HASHES=
USERS_JSON={}
SESSION_TTL=28800
COOKIE_SECURE=false
WEB_UPDATE_ENABLED=false
UPDATE_ALLOWED_GIT_HOST=github.com
VERTEP_UPDATE_SERVER=https://update.vertep.ai
UPDATE_PUBLIC_KEY=/app/installer/update-public.pem
UPDATE_CHANNEL=stable
REQUIRE_UPDATE_KEY_LIFECYCLE=true
# Hardened appliances use a directory of online release keys plus root-signed metadata.
UPDATE_ROOT_METADATA=/app/installer/update-root.json
UPDATE_ROOT_KEYS=/app/installer/root-keys
REQUIRE_OFFLINE_ROOT=true
CONFIG_ROOT=/data/config
UPDATE_TIMEOUT_SECONDS=1800
UPDATE_RELEASE_RETENTION=3
REQUIRE_ROLLING_COMPATIBILITY=true
UPDATE_REQUIRE_DISTRIBUTED_FENCE=true
SECRET_STORE_PASSPHRASE_FILE_HOST=../config/secret-store.passphrase
REQUIRE_SECRET_KEY_SEALING=true
VERTEP_ALLOW_DIRTY_UPDATE=false
MAX_REQUEST_BYTES=30000000
MAX_UPLOAD_BYTES=26214400
MAX_ARTIFACT_BYTES=26214400
MAX_VIDEO_ARTIFACT_BYTES=268435456
MAX_IMPORT_BYTES=209715200
RATE_LIMIT_PER_MINUTE=300
JOB_RETENTION_DAYS=30
AUTO_CLEANUP=false
MAX_RETRIES=3
SUPPORTED_TASKS=image
SUPPORTED_WORKFLOWS=*
WORKER_REQUIRE_GPU=true
WORKER_SELF_TEST_MAX_AGE_SECONDS=900
WORKER_CLOCK_SKEW_SECONDS=300
TASK_LEASE_SECONDS=90
WATCHDOG_INTERVAL=5
RETRY_BACKOFF_BASE=2
LOG_ROOT=/data/logs
LOG_LEVEL=INFO
TTS_PROVIDER=none
PUBLISHER_MOCK=false
PUBLISH_MAX_RETRIES=3
# --- LLM (Phase 2) ---
# VERTEP_LLM_PROVIDER selects the LLM client: "ollama" (default) or "openai".
VERTEP_LLM_PROVIDER=ollama
# Required when VERTEP_LLM_PROVIDER=openai (OpenAI-compatible chat completions):
OPENAI_COMPAT_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# TTS_PROVIDER: none | mock | piper | kokoro (piper/kokoro are live open-source backends)
# TTS_PROVIDER=piper

# --- Publisher credentials (Phase 3 live adapters) ---
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_X_TT_POST=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- Compute (Phase 4 optional ComfyUI-Distributed) ---
# Default compute stays the VertepWorker provider (attached ComfyUI).
# Enable the ComfyUI-Distributed proxy only when both flags are set:
# VERTEP_COMPUTE_PROVIDER: vertep-worker (default) | comfyui-distributed
VERTEP_COMPUTE_PROVIDER=vertep-worker
COMFYUI_DISTRIBUTED_URL=
COMFYUI_DISTRIBUTED_TOKEN=
# COMFYUI_DISTRIBUTED_POLL_INTERVAL=2.0
# COMFYUI_DISTRIBUTED_TIMEOUT=300.0

# --- Video engine (Phase 5 optional external engines) ---
# Default is the native Vertep FFmpeg assembly pipeline. External engines
# (MoneyPrinter / ShortGPT style bridges) are used only when explicitly enabled
# AND the render URL is configured; otherwise native is used.
# VERTEP_VIDEO_ENGINE: native (default) | money-printer | shortgpt
VERTEP_VIDEO_ENGINE=native
MONEY_PRINTER_URL=
MONEY_PRINTER_TOKEN=
SHORTGPT_URL=
SHORTGPT_TOKEN=
# MONEY_PRINTER_POLL_INTERVAL=2.0
# MONEY_PRINTER_TIMEOUT=600.0
