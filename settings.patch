+  confirmRestore(snapshotId: string): void {
+    const state = this.systemState();
+    if (state && state['state'] && !['MAINTENANCE', 'READ_ONLY', 'RECOVERING'].includes(state['state'] as string)) {
+      this.backupsError.set(`Відновлення заборонено в стані ${state['state']}. Перемкніть систему у MAINTENANCE/READ_ONLY/RECOVERING.`);
+      return;
+    }
+    if (!confirm(`Відновити бекап ${snapshotId}? Ця дія необоротна.`)) return;
+    this.restoring.set(snapshotId);
+    this.restoreProgress.set({ progress: 0, message: 'Запуск відновлення...' });
+    this.api.restoreBackup(snapshotId).subscribe({
+      next: () => this.pollRestoreProgress(snapshotId),
+      error: (err) => { this.backupsError.set(err.message); this.restoring.set(null); this.restoreProgress.set(null); },
+    });
+  }
+
+  private pollRestoreProgress(snapshotId: string, attempts = 0): void {
+    const maxAttempts = 120;
+    if (attempts >= maxAttempts) {
+      this.backupsError.set('Перевищено час очікування відновлення');
+      this.restoring.set(null);
+      this.restoreProgress.set(null);
+      this.loadBackups();
+      return;
+    }
+    setTimeout(() => {
+      this.api.getRestoreProgress(snapshotId).subscribe({
+        next: (data) => {
+          const progress = ((data['progress'] as number) || 0);
+          const message = (data['message'] as string) || 'Відновлення...';
+          const status = (data['status'] as string) || 'unknown';
+          this.restoreProgress.set({ progress, message });
+          if (status === 'done') {
+            this.toast.show('Відновлення завершено', 'success');
+            this.restoring.set(null);
+            this.restoreProgress.set(null);
+            this.loadBackups();
+            this.loadSystemState();
+          } else if (status === 'error') {
+            this.backupsError.set(message || 'Помилка відновлення');
+            this.restoring.set(null);
+            this.restoreProgress.set(null);
+            this.loadBackups();
+          } else {
+            this.pollRestoreProgress(snapshotId, attempts + 1);
+          }
+        },
+        error: () => this.pollRestoreProgress(snapshotId, attempts + 1),
+      });
+    }, 2000);
+  }
+
+  isRestoreAllowed(): boolean {
+    const state = this.systemState();
+    if (!state) return false;
+    return ['MAINTENANCE', 'READ_ONLY', 'RECOVERING'].includes(state['state'] as string);
+  }
 }
 
