server {
  listen 8443 ssl;
  server_name ${WEB_DOMAIN};
  ssl_certificate /etc/vertep/tls/vertep.crt;
  ssl_certificate_key /etc/vertep/tls/vertep.key;
  ssl_client_certificate /etc/vertep/tls/node-ca.crt;
  ssl_crl /etc/vertep/revocation/node-ca.crl;
  ssl_verify_client optional;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 256m;
  location / { proxy_pass http://core:8080; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; }
  location ~ ^/api/(workers/heartbeat|tasks/(claim|renew|cancellations|result)|logs/ingest|node/status|nodes/[a-z0-9-]+/renew) {
    if ($ssl_client_verify != SUCCESS) { return 401; }
    proxy_pass http://core:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Vertep-Client-DN $ssl_client_s_dn;
    proxy_set_header X-Vertep-Client-Serial $ssl_client_serial;
    proxy_set_header X-Forwarded-Proto https;
  }
}
