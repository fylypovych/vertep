# i.0.0.4.72: node identity comes only from a TLS peer certificate that nginx
# verified against node-ca; anything else is sent as an empty header, which
# nginx drops, so a client-supplied X-Vertep-Client-DN/Serial never reaches CORE.
map $ssl_client_verify $vertep_client_dn { SUCCESS $ssl_client_s_dn; default ""; }
map $ssl_client_verify $vertep_client_serial { SUCCESS $ssl_client_serial; default ""; }
server {
  listen 8443 ssl;
  server_name ${WEB_DOMAIN};
  ssl_certificate /etc/vertep/tls/vertep.crt;
  ssl_certificate_key /etc/vertep/tls/vertep.key;
  ssl_client_certificate /etc/vertep/tls/node-ca.crt;
  ssl_crl /etc/vertep/revocation/node-ca.crl;
  ssl_verify_client optional;
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 256m;
  # #553 AC8: HSTS on every HTTPS response (inherited by CORE locations that
  # declare no location-level add_header, and repeated in location / below).
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  # #504: the panel is a separate web-ui container. Docker DNS is resolved per
  # request, so a stopped or missing web-ui never stops the proxy or CORE.
  resolver 127.0.0.11 valid=10s ipv6=off;
  location / {
    set $vertep_web_ui http://web-ui:8080;
    proxy_pass $vertep_web_ui;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    # #553 AC8: hide upstream copies to prevent duplicates while enforcing
    # Web UI HTML security headers + HSTS (location add_header overrides server).
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ws: wss:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }
  location ~ ^/api/(workers/heartbeat|tasks/(claim|renew|cancellations|result)|logs/ingest|node/status|nodes/[a-z0-9-]+/(renew|token)) {
    if ($ssl_client_verify != SUCCESS) { return 401; }
    proxy_pass http://core:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Vertep-Client-DN $vertep_client_dn;
    proxy_set_header X-Vertep-Client-Serial $vertep_client_serial;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
  # CORE: the API and its other HTTP surfaces (job files, LAB lease,
  # status, API docs, the /admin alias).
  location ~ ^/(api/|jobs/[^/]+/files/|lab-lease/|status$|docs|redoc$|openapi\.json$|admin$) {
    proxy_pass http://core:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Vertep-Client-DN $vertep_client_dn;
    proxy_set_header X-Vertep-Client-Serial $vertep_client_serial;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
}
