FROM nginx:1.27-alpine

# Only the Lab frontend is mounted here; the production Web UI is not bundled.
COPY deploy/lab/web/nginx.conf /etc/nginx/nginx.conf
RUN mkdir -p /srv/lab-web && chown nginx:nginx /srv/lab-web

USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/readyz || exit 1

ENTRYPOINT ["nginx"]
CMD ["-c", "/etc/nginx/nginx.conf", "-g", "daemon off;"]
