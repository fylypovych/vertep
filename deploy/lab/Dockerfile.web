# Separate Angular laboratory panel baked into its own image (Issue #251, U1).
# The panel has no runtime dependency on production CORE or its web-v2 build.
FROM node:24-alpine AS build

WORKDIR /src
COPY deploy/lab/web/app/package.json deploy/lab/web/app/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY deploy/lab/web/app/ ./
RUN npm run build

FROM nginx:1.27-alpine

# Only the Lab frontend is served here; the production Web UI is not bundled.
# Explicit mode: the host checkout may carry 0600 files (a root umask of 077), and
# nginx runs as the unprivileged nginx user (observed on the LAB VM, 16.11.2026).
COPY --chmod=0644 deploy/lab/web/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /src/dist/vertep-lab-web/browser /srv/lab-web
RUN chown -R nginx:nginx /srv/lab-web && chmod -R a+rX /srv/lab-web

USER nginx
EXPOSE 8443
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/readyz || exit 1

# The connected Vertep (LAB_VERTEP_URL) may frame the panel; only an https://host[:port]
# value is used, anything else leaves frame-ancestors at 'self'.
ENTRYPOINT ["/bin/sh", "-c", "u=\"${LAB_VERTEP_URL%/}\"; printf '%s' \"$u\" | grep -Eq '^https://[A-Za-z0-9.:-]+$' || u=''; printf 'add_header Content-Security-Policy \"frame-ancestors %s\" always;\\n' \"'self' $u\" > /tmp/lab-frame.conf && exec nginx -c /etc/nginx/nginx.conf -g 'daemon off;'"]
